generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENDEDOR
}

enum Status {
  ACTIVE
  INACTIVE
}

enum LotType {
  BEEF
  PORK
}

enum MovementType {
  ENTRADA
  VENTA
  AJUSTE
  DEVOLUCION
  MERMA
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  NEQUI
  DAVIPLATA
  OTROS
}

enum SaleStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  password_hash String
  name          String
  role          Role     @default(VENDEDOR)
  status        Status   @default(ACTIVE)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  lots_created        AnimalLot[]
  products_created    Product[]
  sales               Sale[]
  inventory_movements InventoryMovement[]
  audit_logs          AuditLog[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  status      Status   @default(ACTIVE)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model CutCatalog {
  id          String   @id @default(uuid())
  name        String
  meat_type   LotType
  description String?
  status      Status   @default(ACTIVE)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  lot_cuts LotCut[]

  @@unique([name, meat_type])
  @@map("cut_catalogs")
}

model AnimalLot {
  id                 String   @id @default(uuid())
  lot_type           LotType
  consecutive_number Int
  lot_code           String   @unique
  date               DateTime @default(now())
  description        String?  @db.Text
  purchase_price     Decimal  @db.Decimal(12, 2)
  created_by_user_id String
  status             Status   @default(ACTIVE)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  created_by User     @relation(fields: [created_by_user_id], references: [id])
  cuts       LotCut[]

  @@map("animal_lots")
}

model LotCut {
  id             String   @id @default(uuid())
  lot_id         String
  cut_catalog_id String
  initial_weight Decimal  @db.Decimal(10, 3)
  current_stock  Decimal  @db.Decimal(10, 3)
  price_per_kg   Decimal  @db.Decimal(12, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  lot         AnimalLot           @relation(fields: [lot_id], references: [id], onDelete: Restrict)
  cut_catalog CutCatalog          @relation(fields: [cut_catalog_id], references: [id], onDelete: Restrict)
  sale_items  SaleItem[]
  movements   InventoryMovement[]

  @@map("lot_cuts")
}

model Product {
  id                 String   @id @default(uuid())
  name               String
  category_id        String
  description        String?  @db.Text
  unit_measure       String   @default("kg")
  current_stock      Decimal  @db.Decimal(10, 3) @default(0.000)
  sale_price         Decimal  @db.Decimal(12, 2)
  status             Status   @default(ACTIVE)
  created_by_user_id String
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  category   Category            @relation(fields: [category_id], references: [id], onDelete: Restrict)
  created_by User                @relation(fields: [created_by_user_id], references: [id])
  sale_items SaleItem[]
  movements  InventoryMovement[]

  @@map("products")
}

model Sale {
  id                 String        @id @default(uuid())
  sale_number        String        @unique
  consecutive_number Int
  user_id            String
  payment_method     PaymentMethod @default(EFECTIVO)
  total_amount       Decimal       @db.Decimal(12, 2)
  idempotency_key    String        @unique
  status             SaleStatus    @default(CONFIRMED)
  notes              String?
  created_at         DateTime      @default(now())

  user  User       @relation(fields: [user_id], references: [id])
  items SaleItem[]

  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid())
  sale_id     String
  lot_cut_id  String?
  product_id  String?
  item_name   String
  lot_code    String?
  quantity    Decimal  @db.Decimal(10, 3)
  unit_price  Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)

  sale    Sale     @relation(fields: [sale_id], references: [id], onDelete: Restrict)
  lot_cut LotCut?  @relation(fields: [lot_cut_id], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@map("sale_items")
}

model InventoryMovement {
  id             String       @id @default(uuid())
  movement_type  MovementType
  lot_cut_id     String?
  product_id     String?
  quantity       Decimal      @db.Decimal(10, 3)
  previous_stock Decimal      @db.Decimal(10, 3)
  new_stock      Decimal      @db.Decimal(10, 3)
  reference_id   String?
  user_id        String
  notes          String?      @db.Text
  created_at     DateTime     @default(now())

  lot_cut LotCut?  @relation(fields: [lot_cut_id], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [product_id], references: [id], onDelete: Restrict)
  user    User     @relation(fields: [user_id], references: [id])

  @@map("inventory_movements")
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String
  action     String
  entity     String
  entity_id  String
  details    String?  @db.Text
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}

model SystemSettings {
  id            String   @id @default("default")
  business_name String   @default("Carnicería")
  theme_color   String   @default("red") // red, burgundy, slate, emerald, blue
  address       String?
  phone         String?
  receipt_note  String?
  updated_at    DateTime @updatedAt

  @@map("system_settings")
}
